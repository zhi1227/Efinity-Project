# Local editor settings and document lock files
.vscode/
~$*
~$$*

# FPGA synthesis, place/route and simulation caches
work_syn/
work_pnr/
work_dbg/
work_pt/
greybox_tmp/
work/
db/
incremental_db/
*.wlf
*.vcd
*.qws
transcript
__pycache__/
.Xil/
.workbuddy/
xsim.dir/
*.jou
webtalk*.log
xsim*.log
xelab.log
xelab.pb
xvlog.log
xvlog.pb

# Local analysis and generated simulation runs. Testbench sources under tb/
# and reusable scripts under tools/ remain versioned.
_analysis/
sim/
sim_modular/

# Quartus reference-project generated output
/FPGA_Sobel/project/output_files/
/FPGA_Sobel/project/simulation/
/FPGA_Sobel/project/PLLJ_PLLSPE_INFO.txt
/FPGA_Sobel/project/*.jic

# Keep the tested Ti60 bitstream and timing report, not intermediate netlists
/Ti60F225_GitHub_FPGA_Sobel_Port/outflow/*
!/Ti60F225_GitHub_FPGA_Sobel_Port/outflow/Ti60_Demo.bit
!/Ti60F225_GitHub_FPGA_Sobel_Port/outflow/Ti60_Demo.timing.rpt

# New Efinity projects: keep reproducible sources and release artifacts, but
# do not version the large generated outflow directory.
**/outflow/*
!**/outflow/*.bit
!**/outflow/*.timing.rpt
