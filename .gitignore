# Local analysis and generated simulation runs. Testbench sources under tb/
# and reusable scripts under tools/ remain versioned.
_analysis/
sim/
sim_modular/

# Quartus reference-project generated output
/FPGA_Sobel/project/output_files/
/FPGA_Sobel/project/simulation/
/FPGA_Sobel/project/PLLJ_PLLSPE_INFO.txt
/FPGA_Sobel/project/*.jic

# Quartus compilation outputs for bundled reference projects
/2026.10.01/FPGA-Edge-Detection-Project1/par/output_files/

# Temporary simulation runs and dated snapshots in the 10.12 project drop
/2026.10.12/10_11_ding_Ti60_Vision8_Buttons_Integrated/backups/
/2026.10.12/10_11_ding_Ti60_Vision8_Buttons_Integrated/sim_*/

# 10.13 snapshot: avoid duplicating the identical 10.12 project and local run snapshots
/2026.10.13/10.12 guo Gesture_ROI_full_project/
/2026.10.13/10_13_ding_Ti60_Vision8_Gesture_ROI_Integrated/backups/
/2026.10.13/10_13_ding_Ti60_Vision8_Gesture_ROI_Integrated/sim_*/

# 10.16 IO28 button-fix project: omit generated simulation run folders and
# the identical project copy stored with technical-document drafting files.
/2026.10.16/10_16_ding_Ti60_Vision8_IO28_ButtonFix/sim_*/
/2026.10.16/10_16_ding_Ti60_Vision8_IO28_ButtonFix/firmware/build/
/2026.10.16/10_16_ding_Ti60_Vision8_IO28_ButtonFix/EfxSapphireSoc.v_toplevel_system_ramA_logic_ram_symbol*.bin
