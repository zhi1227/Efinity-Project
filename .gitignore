# Keep the tested Ti60 bitstream and timing report, not intermediate netlists
/Ti60F225_GitHub_FPGA_Sobel_Port/outflow/*
!/Ti60F225_GitHub_FPGA_Sobel_Port/outflow/Ti60_Demo.bit
!/Ti60F225_GitHub_FPGA_Sobel_Port/outflow/Ti60_Demo.timing.rpt

# New Efinity projects: keep reproducible sources and release artifacts, but
# do not version the large generated outflow directory.
**/outflow/*
!**/outflow/*.bit
!**/outflow/*.timing.rpt
