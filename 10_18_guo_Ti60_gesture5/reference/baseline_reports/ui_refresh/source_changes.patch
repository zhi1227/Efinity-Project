+	//	Do not issue DDR read / write when ~cal_done. 
+	reg 			r_ddr_unlock = 0; 
+	always @(posedge w_ddr3_ui_clk or negedge w_ddr3_ui_aresetn) begin
+		if(~w_ddr3_ui_aresetn)
+			r_ddr_unlock <= 0; 
+		else
+			r_ddr_unlock <= w_ddr3_cal_done && w_ddr3_cal_pass; 
+	end
+	
+	DdrCtrl ddr3_ctl_axi (	
