+    assign flash_data_oe = r_flash_en ? w_spi_data_oe : 4'b0000;
+    assign w_spi_data_i = flash_data_i;
+    assign spi_sck_o = w_spi_sck_o;
+    assign spi_ssn_o = w_spi_ssn_o; 
