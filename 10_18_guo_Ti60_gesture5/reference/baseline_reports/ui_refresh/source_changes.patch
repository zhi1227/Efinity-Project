+	wire  [7:0] 	w_dev_index_o;  
+	wire  [7:0] 	w_dev_cmd_o;  
+	wire  [31:0] 	w_dev_wdata_o;  
+	wire  		w_dev_wvalid_o;  
+	wire  		w_dev_rvalid_o;  
+	wire 	[31:0] 	w_dev_rdata_i;  
+	
+	wire 			w_spi_ssn_o, w_spi_sck_o; 
+	wire 	[3:0] 	w_spi_data_o, w_spi_data_oe; 
+	wire 	[3:0] 	w_spi_data_i; 
