+	(
+	    .LUT_INDEX  (ov5640_i2c_config_index   ),
+	    .LUT_DATA   (ov5640_i2c_config_data    ),
+	    .LUT_SIZE   (ov5640_i2c_config_size    )
+	); 
+	
+	
+	//	CMOS Interface
+	//input 			cmos_pclk,
+	//input 			cmos_vsync,
+	//input 			cmos_href,
+	//input 	[7:0] 	cmos_data,
+	
+	wire 			w_cmos_pclk = cmos_pclk;
+ (* async_reg="true" *)reg[1:0]cam_reset_pipe,cam_enable_pipe;
